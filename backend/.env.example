# Flask 环境配置
FLASK_ENV=development

# 数据库 URL (生产环境使用 PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/datasci

# 新闻 API 密钥
NEWS_API_KEY=your_news_api_key_here
